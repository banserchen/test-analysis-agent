# TAA_ prefix is used for all environment variables

# ─── LLM Configuration ─────────────────────────────────────────────
# LLM provider: "openai" for OpenAI-compatible API, "copilot" for GitHub Copilot SDK
TAA_LLM_PROVIDER=copilot
# API key for the LLM provider (OpenAI key, or GitHub token for Copilot)
TAA_LLM_API_KEY=your-api-key-here
# Base URL (change for Azure OpenAI or self-hosted models; only used with openai provider)
#TAA_LLM_BASE_URL=https://api.openai.com/v1
TAA_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Model name
TAA_LLM_MODEL=gpt-5.4
# Max tokens for LLM response
TAA_LLM_MAX_TOKENS=4096
# Temperature (lower = more deterministic)
TAA_LLM_TEMPERATURE=0.2

# ─── Jenkins Configuration ─────────────────────────────────────────
TAA_JENKINS_URL=http://192.168.103.26:8080
TAA_JENKINS_USERNAME=devops
TAA_JENKINS_PASSWORD=your-api-token

# ─── Agent Configuration ───────────────────────────────────────────
# Directory containing custom skill plugins
TAA_SKILLS_DIR=
# Maximum log lines to send to LLM
TAA_MAX_LOG_LINES=5000
# Report language: zh-CN for Chinese, en for English
TAA_REPORT_LANGUAGE=zh-CN

# ─── Infrastructure Inspector ──────────────────────────────────────
# Base URL of the test environments API (enables SSH-based env health checks)
# Leave empty to disable infrastructure inspection
TAA_ENVIRONMENTS_API_URL=

# ─── Feishu Integration ────────────────────────────────────────────
# Feishu Open Platform app credentials (for creating cloud documents)
TAA_FEISHU_APP_ID=cli_a9619a746cb81bb5
TAA_FEISHU_APP_SECRET=
# Folder token where reports will be saved (bot must own this folder)
TAA_FEISHU_FOLDER_TOKEN=

# ─── API Server Configuration ──────────────────────────────────────
TAA_API_HOST=0.0.0.0
TAA_API_PORT=9090
